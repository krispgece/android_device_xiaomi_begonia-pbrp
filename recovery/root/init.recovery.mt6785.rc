import /microtrust_begonia.rc

on early-init
    start adbd

on init
    # Create a more standard /dev/block layout for our scripts
    symlink /dev/block/platform/bootdevice /dev/block/bootdevice
    export LD_LIBRARY_PATH /system/lib64:/vendor/lib64:/vendor/lib64/hw

    # configfs USB from the start (init.rc sets 0 at early-init), so that the
    # recovery's init.rc builds the gadget, ffs.fastboot included, on fs
    setprop sys.usb.configfs 1

    # Dynamic or legacy ROM: append the matching recovery.fstab and twrp.flags
    # entries before the recovery reads them (its service starts on boot)
    exec u:r:recovery:s0 -- /system/bin/begonia-layout.sh

on property:ro.crypto.state=encrypted && property:ro.crypto.type=file
    install_keyring

on post-fs

service gatekeeper-1-0 /vendor/bin/hw/android.hardware.gatekeeper@1.0-service
    interface android.hardware.gatekeeper@1.0::IGatekeeper default
    user root
    group root
    disabled
    seclabel u:r:recovery:s0

service keymaster-4-0-beanpod /vendor/bin/hw/android.hardware.keymaster@4.0-service.beanpod
    interface android.hardware.keymaster@4.0::IKeymasterDevice default
    user root
    group root drmrpc
    disabled
    seclabel u:r:recovery:s0

on property:hwservicemanager.ready=true
    write /proc/bootprof "start teei_daemon (on fs)"
    start teei_daemon
    write /proc/bootprof "start teei_daemon end (on fs)"
    start keymaster-4-0-beanpod
    start gatekeeper-1-0

on property:ro.crypto.state=unsupported
    stop teei_daemon
    stop keymaster-4-0-beanpod
    stop gatekeeper-1-0
    stop servicemanager
    stop hwservicemanager

on property:ro.crypto.state=unencrypted
    stop teei_daemon
    stop keymaster-4-0-beanpod
    stop gatekeeper-1-0
    stop servicemanager
    stop hwservicemanager

on property:twrp.decrypt.done=true
    stop teei_daemon
    stop keymaster-4-0-beanpod
    stop gatekeeper-1-0
    stop servicemanager
    stop hwservicemanager

# fastbootd and the battery readout ask for the health HAL that the vendor
# manifest declares (android.hardware.health@2.1); recovery does not start
# class hal, so start it once hwservicemanager is up, or fastbootd waits
# for it forever and never sets up its USB function.
on property:hwservicemanager.ready=true
    start health-hal-2-1
